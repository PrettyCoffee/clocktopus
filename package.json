{
  "name": "clocktopus",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "l10n:build": "lingui extract --clean --overwrite && lingui compile --strict",
    "build": "tsc -b && pnpm run l10n:build && vite build",
    "build:release": "node ./scripts/build-release.ts",
    "publish": "node ./scripts/publish.ts",
    "preview": "vite preview",
    "knip": "knip",
    "knip:fix": "knip --fix-type exports,types",
    "knip:ci": "knip",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "validate": "pnpm run build && pnpm run knip && pnpm run lint",
    "analyze": "analyze"
  },
  "engines": {
    "pnpm": "^11",
    "node": ">=24"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@lingui/core": "5.9.5",
    "@lingui/react": "5.9.5",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@yaasl/core": "0.15.0-alpha.1",
    "@yaasl/devtools": "0.15.0-alpha.1",
    "@yaasl/react": "0.15.0-alpha.1",
    "class-variance-authority": "0.7.1",
    "goober": "2.1.19",
    "lucide-react": "1.61.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "5.9.5",
    "@lingui/cli": "5.9.5",
    "@lingui/vite-plugin": "5.9.5",
    "@pretty-cozy/oxlint-config": "0.2.2",
    "@pretty-cozy/release-tools": "0.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-bundle-analyzer": "1.3.9"
  },
  "overrides": {
    "@radix-ui/react-slot": "1.5.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
