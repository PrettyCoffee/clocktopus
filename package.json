{
  "name": "clocktopus",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "l10n:build": "lingui extract --clean --overwrite && lingui compile --strict",
    "build": "tsc -b && pnpm run l10n:build && vite build",
    "build:release": "node ./scripts/build-release.ts",
    "publish": "node ./scripts/publish.ts",
    "preview": "vite preview",
    "knip": "knip",
    "knip:fix": "knip --fix-type exports,types",
    "knip:ci": "knip",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "lint:time": "TIMING=15 pnpm run lint",
    "lint:inspect": "eslint --inspect-config",
    "validate": "pnpm run build && pnpm run knip && pnpm run lint",
    "analyze": "analyze"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@lingui/core": "5.9.5",
    "@lingui/react": "5.9.5",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@yaasl/core": "0.15.0-alpha.1",
    "@yaasl/devtools": "0.15.0-alpha.1",
    "@yaasl/react": "0.15.0-alpha.1",
    "class-variance-authority": "0.7.1",
    "goober": "2.1.19",
    "lucide-react": "1.39.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "wouter": "3.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "5.9.5",
    "@lingui/cli": "5.9.5",
    "@lingui/vite-plugin": "5.9.5",
    "@pretty-cozy/eslint-config": "0.10.0",
    "@pretty-cozy/release-tools": "0.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "knip": "6.34.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-bundle-analyzer": "1.3.9"
  },
  "overrides": {
    "@radix-ui/react-slot": "1.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
